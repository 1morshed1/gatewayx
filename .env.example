# Copy to `.env` and adjust as needed. Loaded by the gateway at startup.
# Every value here has a sane default in internal/config, so an empty .env works
# against the docker-compose stack.

# --- HTTP listeners ---
GATEWAY_ADDR=:8000          # public traffic proxied to upstreams
ADMIN_ADDR=:8001            # admin API (routes, keys, plugins, metrics)
METRICS_ADDR=:9100          # Prometheus /metrics endpoint

# --- Postgres (config + analytics) ---
POSTGRES_DSN=postgres://gatewayx:gatewayx@localhost:5432/gatewayx?sslmode=disable

# --- Redis (rate limit + circuit breaker state) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Kafka (request analytics stream) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=request-logs
KAFKA_ENABLED=true

# --- Admin API ---
ADMIN_TOKEN=                # when set, required as X-Admin-Token on admin mutations

# --- Behaviour ---
LOG_LEVEL=info              # debug|info|warn|error
CONFIG_RELOAD_MODE=listen   # listen (LISTEN/NOTIFY) | poll
CONFIG_POLL_INTERVAL=15s    # only used when CONFIG_RELOAD_MODE=poll
