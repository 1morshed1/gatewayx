# Multi-stage build for the demo upstream echo service.
# Stage 1 compiles a static binary; stage 2 ships it on a scratch-like base.
FROM golang:1.25-alpine AS build
WORKDIR /src
# Only go.mod first for layer caching. The echo service has no external deps,
# so go.sum may be absent; copy it opportunistically.
COPY go.mod ./
COPY go.sum* ./
RUN go mod download || true
COPY cmd/echo ./cmd/echo
RUN CGO_ENABLED=0 go build -o /out/echo ./cmd/echo

FROM alpine:3.20
RUN adduser -D -u 10001 app
USER app
COPY --from=build /out/echo /usr/local/bin/echo
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/echo"]
